# =========================================================
# Ruchi Bites — Environment Variables
# Copy this file's contents into Vercel → Project → Settings →
# Environment Variables (NOT into a committed .env file with real
# secrets). See README.md for step-by-step instructions on getting
# each value.
# =========================================================

# ---- Razorpay (Settings → API Keys in Razorpay Dashboard) ----
# KEY_ID also needs to be pasted into assets/js/site-config.js (it is
# public/safe to expose). KEY_SECRET must stay ONLY here, never in
# any file that reaches the browser.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- Twilio WhatsApp (console.twilio.com) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio WhatsApp sandbox number is whatsapp:+14155238886 — replace once
# you have an approved production WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Store owner notifications (where YOU get notified of new orders) ----
STORE_WHATSAPP_TO=919000000000
STORE_EMAIL_TO=hello@ruchibites.com

# ---- Outgoing email (SMTP) ----
# Easiest option: a Gmail address + an "App Password" (not your normal
# Gmail password) — see README. You can also use Zoho Mail, Resend SMTP,
# SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=youraddress@gmail.com
